--q2


--a 
CREATE TABLE Employee (
    empID STRING,
    Name STRING,
    deptID STRING,
    position STRING,
    salary FLOAT,
    date_of_joining STRING
) ROW FORMAT DELIMITED FIELDS TERMINATED BY ',';

CREATE TABLE Department (
    deptID STRING,
    dept_name STRING,
    location STRING,
    managerID STRING
) ROW FORMAT DELIMITED FIELDS TERMINATED BY ',';

CREATE TABLE Project (
    projectID STRING,
    project_name STRING,
    deptID STRING,
    budget FLOAT
) ROW FORMAT DELIMITED FIELDS TERMINATED BY ',';

CREATE TABLE Employee_Project (
    empID STRING,
    projectID STRING,
    hours_worked INT
) ROW FORMAT DELIMITED FIELDS TERMINATED BY ',';

