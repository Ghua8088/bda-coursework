--q1
/*
1. Suppose we have a tuples with the schemas as Grades (University, courseID,
studentID,
grade) and Course (courseID, Department name, Course name, No of students
enrolled) Dept (deptID, Name), and Student ( studentID, Name, CourseID, CGPA).
Assume Course IDs are unique, but a courseID is available to all departments.
Likewise, studentID’s are unique with department. Write commands to obtain results
to the following queries using HIVE:
a. Creating tables
b. Insert tuples for each table.
c. Sort the students according to their GPA course wise.
d. Filter student with specific course and department.
*/

--a
CREATE TABLE Grades (
    University STRING,
    courseID STRING,
    studentID STRING,
    grade STRING
) ROW FORMAT DELIMITED FIELDS TERMINATED BY ',';

CREATE TABLE Course (
    courseID STRING,
    Department_name STRING,
    Course_name STRING,
    No_of_students_enrolled INT
) ROW FORMAT DELIMITED FIELDS TERMINATED BY ',';

CREATE TABLE Dept (
    deptID STRING,
    Name STRING
) ROW FORMAT DELIMITED FIELDS TERMINATED BY ',';

CREATE TABLE Student (
    studentID STRING,
    Name STRING,
    CourseID STRING,
    CGPA FLOAT
) ROW FORMAT DELIMITED FIELDS TERMINATED BY ',';

