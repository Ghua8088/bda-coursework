--c
SELECT e.empID, e.Name, e.position, d.dept_name 
FROM Employee e
JOIN Department d ON e.deptID = d.deptID
WHERE d.dept_name = 'Sales' AND e.position = 'Manager';

--d
SELECT ep.projectID, sum(ep.hours_worked) as total_hours from Employee_Project ep
join Employee e on ep.empID = e.empID
where e.deptID = 'D10'
GROUP BY   ep.projectID;

